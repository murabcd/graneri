    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^29.0.1",
    "typescript": "7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.9"
  },
  "knip": {
    "ignore": [
      "src/canvas-confetti.d.ts",
      "src/electron.d.ts",
      "src/vite-env.d.ts",
      "tests/setup.ts"
