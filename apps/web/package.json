    "@tiptap/markdown": "3.30.1",
    "@tiptap/pm": "3.30.1",
    "@tiptap/react": "3.30.1",
    "@tiptap/starter-kit": "3.30.1",
    "@tiptap/suggestion": "3.30.1",
    "@workspace/ai": "workspace:*",
    "@workspace/platform": "workspace:*",
    "@workspace/ui": "workspace:*",
    "ai": "7.0.31",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sonner": "^2.0.7",
    "streamdown": "^2.6.0",
    "zod": "^4.1.12"
